---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message envoyé"
  description="Votre message a bien été transmis à D2matic."
  noindex
  breadcrumbs={[
    { name: 'Contact', href: '/contact' },
    { name: 'Message envoyé', href: '/contact/merci' },
  ]}
>
  <div class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-4xl font-bold tracking-tight">Message envoyé</h1>
    <p class="mt-4 text-slate-700">Votre message a bien été transmis. Je vous réponds par e-mail.</p>
    <p class="mt-8"><a href="/" class="font-semibold text-brand-700 underline">Retour à l'accueil</a></p>
  </div>
</BaseLayout>
