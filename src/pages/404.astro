---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold">Page introuvable</h1>
    <p class="mt-4 text-slate-700">Cette page n'existe pas ou a été déplacée.</p>
    <p class="mt-8"><a href="/" class="font-semibold text-brand-700 underline">Retour à l'accueil</a></p>
  </div>
</BaseLayout>
