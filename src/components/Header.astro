---
import { SITE } from '../config/site';
import { getPublished } from '../lib/content';

const blog = await getPublished('blog');
const cas = await getPublished('cas-clients');

const links = [
  { href: '/services', label: 'Services' },
  ...(cas.length ? [{ href: '/cas-clients', label: 'Cas clients' }] : []),
  { href: '/a-propos', label: 'À propos' },
  ...(blog.length ? [{ href: '/blog', label: 'Blog' }] : []),
];
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
    <a href="/" class="text-xl font-bold tracking-tight text-ink" aria-label={`${SITE.name}, accueil`}>
      D2<span class="text-brand-600">matic</span>
    </a>
    <nav aria-label="Navigation principale">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={['hover:text-brand-700', isActive(l.href) ? 'text-brand-700 underline underline-offset-4' : 'text-slate-700']}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/contact" class="rounded-md bg-brand-700 px-3 py-2 text-white hover:bg-brand-800">Contact</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
