---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto grid max-w-5xl gap-6 px-4 py-10 text-sm text-slate-700 sm:grid-cols-2">
    <div>
      <p class="font-semibold text-ink">{SITE.name}</p>
      <p>{SITE.tagline}</p>
      <p>
        <a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p>{SITE.legalForm} · SIREN {SITE.siren}</p>
    </div>
    <nav aria-label="Liens de pied de page" class="sm:justify-self-end">
      <ul class="space-y-1">
        <li><a class="hover:text-brand-700" href="/services">Services</a></li>
        <li><a class="hover:text-brand-700" href="/a-propos">À propos</a></li>
        <li><a class="hover:text-brand-700" href="/contact">Contact</a></li>
        <li><a class="hover:text-brand-700" href="/mentions-legales">Mentions légales</a></li>
        <li><a class="hover:text-brand-700" href="/confidentialite">Confidentialité</a></li>
      </ul>
    </nav>
  </div>
  <p class="pb-6 text-center text-xs text-slate-600">© {year} {SITE.name}</p>
</footer>
